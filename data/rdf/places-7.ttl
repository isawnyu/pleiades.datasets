    dcterms:bibliographicCitation "Arachne Domus dei Tigriniani Ostia, (Ostia), Rom (Metropolitanstadt)",
        "Becatti 1960 31",
        "Calza 1940 ",
        "Calza 1941/1942 ",
        "EDCS 13302419 = Ostia 00033a = AE 1941, 00097 = AE 1945, 00054 = AE 1946, +00168 = AE 1948, +00041 = AE 1960, 00075 = AE 1962, 00380 = AE 1967, 00076",
