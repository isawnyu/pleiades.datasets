    dcterms:modified "2023-05-11T12:19:17-04:00";
    dcterms:subject "ANE",
        "Assyrian";
    dcterms:title "Assur Archive 36";
    owl:sameAs <http://pleiades.stoa.org/places/716451807/assur-archive-36> .

