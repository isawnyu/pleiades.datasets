<https://pleiades.stoa.org/places/772486313> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "Pedersén 1986 104",
        "Pedersén 1998 139";
    dcterms:contributor <https://pleiades.stoa.org/author/ptushingham>;
    dcterms:creator <https://pleiades.stoa.org/author/tseidler>;
    dcterms:description "In a chamber of House 5 (dA6II), situated where \"Ost Strasse\" forks into two lanes, excavators found a small archive of 15 nearly complete and several fragmentary clay tablets. One fragmentary text seems to be a purchase document concerning the acquisition of a woman.";
    dcterms:modified "2023-05-11T12:17:50-04:00";
    dcterms:subject "ANE",
        "Assyrian";
    dcterms:title "Assur Archive 31";
    cito:citesForInformation <http://uu.diva-portal.org/smash/get/diva2:88568/FULLTEXT01.pdf>,
        <https://www.zotero.org/groups/pleiades/items/2FXZ7SLX>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/893945>;
    owl:sameAs <http://pleiades.stoa.org/places/772486313>;
    skos:altLabel "Assur Archive 31"@en,
        "N 16 Archive"@en;
    skos:inScheme <https://pleiades.stoa.org/places>;
    prov:wasDerivedFrom [ rdfs:label "Pleiades" ];
    pleiades:hasFeatureType <https://pleiades.stoa.org/vocabularies/archive-repository>;
    pleiades:hasLocation <https://pleiades.stoa.org/places/plan-location-of-assur-archive-31>;
