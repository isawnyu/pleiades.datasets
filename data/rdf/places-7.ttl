<https://pleiades.stoa.org/places/73737782/tanda-1> dcterms:contributor <https://pleiades.stoa.org/author/jbecker>;
    dcterms:creator <https://pleiades.stoa.org/author/enesy>;
    dcterms:description "\"TANDA, a city in the continent of Bengal, and East Indies, in Asia, once the capital of a kingdom. It stands on the E. side of the Ganges, and a little above where that river parts into branches. Here is a considerable trade in cotton and callicoes; the neighbourhood abounds in buffaloes, tigers, and wild game.\" (Seally, 1787, 2nd Vol., s.v. \"Tanda\")";
    dcterms:modified "2026-04-04T18:45:48-04:00";
    dcterms:title "Tanda";
    owl:sameAs <http://pleiades.stoa.org/places/73737782/tanda-1> .

