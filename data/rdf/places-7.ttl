    dcterms:description "Everyday/common Akkadian name of the gate.";
    dcterms:modified "2023-03-03T22:05:14-04:00";
    dcterms:subject "ANE";
    dcterms:title "abul Šibaniba";
    owl:sameAs <http://pleiades.stoa.org/places/719936356/name.2018-02-03.7350627414> .

