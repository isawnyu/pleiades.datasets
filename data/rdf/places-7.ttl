<https://pleiades.stoa.org/places/792574637%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "South Stoa II";
    spatial:C <https://pleiades.stoa.org/places/710563473%23this>,
        <https://pleiades.stoa.org/places/730466010%23this>,
        <https://pleiades.stoa.org/places/807514119%23this>,
        <https://pleiades.stoa.org/places/841476129%23this>;
    rdfs:comment "South Stoa II is the modern name for the stoa that formed the south side of the South Square of the Agora of Athens. It was built in the mid-second century BC, on the site of South Stoa I using material from the Square Peristyle, and destroyed in the Sullan Sack of Athens in 86 BC.";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/792574637> .

