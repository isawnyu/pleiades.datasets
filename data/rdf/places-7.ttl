    dcterms:bibliographicCitation "",
        "Arachne Porta Salaria Rom, (Roma), Rom (Metropolitanstadt)",
        "Nash 1968 2.229-30",
        "Richardson 1992 308-9",
        "Richmond 1930 185-90",
