    dcterms:bibliographicCitation "Anna Perenna, Storia della divinità Romana  con \"sede\" Ai Parioli ",
        "CoopCulture Fonte di Anna Perenna",
        "Info.roma.it 4042: Fonte di Anna Perenna",
        "McIntyre 2020 ",
        "Ovid Fasti (Frazer: Perseus) 3.523-696",
        "Piranomonte 2002 ",
        "Piranomonte 2009 ",
        "Piranomonte 2012 ",
        "Soprintendenza Speciale Archeologia Belle Arti e Paesaggio di Roma Fonte di Anna Perenna",
        "Wikidata Fonte di Anna Perenna (Q55678763)",
        "Wikimedia Commons Category:Fonte di Anna Perenna",
        "Wikipedia (Italian) Fonte di Anna Perenna";
    dcterms:contributor <https://pleiades.stoa.org/author/jbecker>;
    dcterms:creator <https://pleiades.stoa.org/author/thomase>,
        [ a <http://xmlns.com/foaf/0.1/Person>;
            foaf:name "Abigail Graham" ];
    dcterms:description "Sacred to the goddess Anna Perenna and the nymphs, this rectangular fountain surrounded by rupestral inscriptions was excavated on the modern Via Guidubaldo del Monte in Rome's Pinciano neighborhood during the late 20th century. Rich votive deposits complement the picture of the goddess' worship painted by Ovid in the Fasti entry for the Ides of March.";
    dcterms:modified "2025-06-18T18:51:01-04:00";
    dcterms:title "Fountain of Anna Perenna";
    cito:citesAsEvidence <http://data.perseus.org/citations/urn:cts:latinLit:phi0959.phi007.perseus-lat1:3>;
    cito:citesAsRelated <https://commons.wikimedia.org/wiki/Category:Fonte_di_Anna_Perenna>,
        <https://www.info.roma.it/monumenti_dettaglio.asp?ID_schede=4042>,
        <https://www.wikidata.org/wiki/Q55678763>;
    cito:citesForInformation <http://www.worldcat.org/oclc/1133126357>,
        <https://it.wikipedia.org/wiki/Fonte_di_Anna_Perenna>,
        <https://www.coopculture.it/it/poi/anna-perennas-fountain/>,
