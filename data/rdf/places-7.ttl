    dcterms:coverage "Sa el-Hagar";
    dcterms:creator <http://viaf.org/viaf/19689588>;
    dcterms:description "Sais was an ancient Egyptian town located in the Western Nile Delta on the Canopic branch of the Nile River. It served as the provincial capital of Sap-Meh, the fifth nome of Lower Egypt, and became a capital during the Twenty-fourth Dynasty (ca. 732–720 BC) as well as during the Late Period. Herodotus claimed that Osiris was buried at Sais. Other Greek authors, including Plato, maintained a connection between Sais and the goddess Athena.";
    dcterms:modified "2026-03-13T17:19:59-04:00";
    dcterms:subject "dare:ancient=1",
        "dare:feature=major settlement",
        "dare:major=1";
    dcterms:title "Sais";
