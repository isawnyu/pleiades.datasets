        "Loud and Altman 1938 ",
        "Wikipedia (English) Dur-Sharrukin";
    dcterms:contributor <https://pleiades.stoa.org/author/jbecker>;
    dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "The armory (ekal māšarti) of Dūr-Šarrukīn (modern Khorsabad) was located in the lower city, adjacent to the southern stretch of the southwest wall. No inscriptions of the eighth-century-BC Assyrian king Sargon II (r. 721–705 BC) record the construction of \"Palace F,\" although several objects of that ruler were discovered there.";
    dcterms:modified "2021-01-02T17:17:13-04:00";
    dcterms:title "Khorsabad Palace F";
    cito:citesForInformation <https://archeologie.culture.fr/khorsabad/en>,
        <https://en.wikipedia.org/wiki/Dur-Sharrukin>,
        <https://oi.uchicago.edu/research/projects/excavations-khorsabad>,
        <https://www.worldcat.org/oclc/610534200>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/175106248>,
        <https://pleiades.stoa.org/places/21271257>,
        <https://pleiades.stoa.org/places/4517388>,
