<https://pleiades.stoa.org/places/794311060> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "ATAE Assur 21 (N 6) ",
        "Pedersén 1986 81–82",
        "Pedersén 1998 136";
    dcterms:creator <https://pleiades.stoa.org/author/ptushingham>,
        <https://pleiades.stoa.org/author/tseidler>;
    dcterms:description "In what seems to be a Neo-Assyrian layer inside a Parthian house in hC10IV, excavators found the remains of a library, consisting of about 20 fragmentary clay tablets. The largest group of texts are incantations, but the library also included a prayer, lexical lists and a list of persons, as well as a literary text detailing the netherworld vision of an Assyrian prince. One of the texts, a memorandum, dates to the reign of Sin-šarru-iškun (ca. 626–612 BC).";
    dcterms:modified "2023-05-11T11:55:49-04:00";
    dcterms:subject "ANE",
        "Assyrian";
    dcterms:title "Assur Archive 21";
    cito:citesForInformation <http://oracc.museum.upenn.edu/atae/assur_021>,
        <http://uu.diva-portal.org/smash/get/diva2:88568/FULLTEXT01.pdf>,
        <https://www.zotero.org/groups/pleiades/items/2FXZ7SLX>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/893945>;
    owl:sameAs <http://pleiades.stoa.org/places/794311060>;
    skos:altLabel "Assur Archive 21"@en,
        "N 6 Archive"@en;
