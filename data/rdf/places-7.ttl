    dcterms:bibliographicCitation "",
        "Bendinelli 1922 ",
        "Tawfik 2013 ",
        "Wikidata Q3801607: Tomb of the Ottavii",
        "Wikipedia (Italian) Ipogeo degli Ottavi",
        "vici.org 58294: Ipogeo degli Ottavi";
    dcterms:contributor <https://pleiades.stoa.org/author/thomase>;
    dcterms:creator <https://pleiades.stoa.org/author/jbecker>;
    dcterms:description "The mid-third century CE tomb of the Ottavii was discovered beneath the Villino Cardani (now at Via della Stazione di Ottavia, 73) on 17 August 1921. Based on epigraphic evidence, the tomb was occupied by the remains of one Octavia Paolina, her father Octavius Felix, and two other relatives. The archaeological remains of a number of ancient villas are known in the area, mostly lying on property that later belonged to the Colonna family.";
    dcterms:modified "2022-07-28T09:54:06-04:00";
    dcterms:title "Tomb of the Ottavii";
    cito:citesAsRelated <https://vici.org/vici/58294/>,
        <https://www.wikidata.org/wiki/Q3801607>;
