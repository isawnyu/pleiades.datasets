        <https://pleiades.stoa.org/places/491741%23this>,
        <https://pleiades.stoa.org/places/501363%23this>,
        <https://pleiades.stoa.org/places/501386%23this>,
        <https://pleiades.stoa.org/places/501421%23this>,
        <https://pleiades.stoa.org/places/501634%23this>,
        <https://pleiades.stoa.org/places/501646%23this>,
        <https://pleiades.stoa.org/places/540644%23this>,
        <https://pleiades.stoa.org/places/540703%23this>,
        <https://pleiades.stoa.org/places/540730%23this>,
        <https://pleiades.stoa.org/places/540749%23this>,
        <https://pleiades.stoa.org/places/540793%23this>,
        <https://pleiades.stoa.org/places/541137%23this>,
