    dcterms:description "The “everyday” Akkadian name for the Sîn temple at Assur.";
    dcterms:modified "2022-06-07T06:10:05-04:00";
    dcterms:subject "ANE",
        "Assyrian";
    dcterms:title "bīt Sîn";
