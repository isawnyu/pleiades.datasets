    dcterms:bibliographicCitation "",
        "Amm. Marc. (Clark/Rolfe: Perseus) 27.3.8",
        "Arachne Thermen des Konstantin Rom, (Roma), Rom (Metropolitanstadt)",
        "CIL 6.1750",
