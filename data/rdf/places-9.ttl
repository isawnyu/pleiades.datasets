    dcterms:bibliographicCitation "CFL/AGO FRANCHTHI CAVE - 2014",
        "Kabukcu et al. 2023 ",
        "ToposText Franchthi cave (Argolid) opposite Kilada",
        "Wikidata Franchthi Cave (Q1441331)",
        "Wikipedia (English) Franchthi Cave",
        "iDAI.gazetteer 2361700: Franchthi Höhle";
    dcterms:contributor <https://pleiades.stoa.org/author/bkiesling>,
        <https://pleiades.stoa.org/author/cbouras>,
        <https://pleiades.stoa.org/author/gmckee>;
    dcterms:creator <https://pleiades.stoa.org/author/jbecker>;
    dcterms:description "The Franchthi Cave is located on the Argolic Gulf in southeastern Argolis. The cave and the area outside its entrance (known as the Paralia) were occupied from the Paleolithic (ca. 20,000 BC) through to the Mesolithic and Neolithic periods, ultimately being abandoned ca. 3000 BC. The cave shows continuous human occupation for more than 20,000 years.";
