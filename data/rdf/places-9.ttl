    dcterms:description "Representative locations of the Neo-Assyrian archive at Kalhu on the basis of Pedersén 1987 Plan(s) 66–67.";
    dcterms:modified "2023-05-11T12:45:34-04:00";
    dcterms:subject "ANE",
        "Assyrian";
    dcterms:title "Plan location of Kalhu Archive 3";
