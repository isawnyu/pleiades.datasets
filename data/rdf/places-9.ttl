    dcterms:bibliographicCitation "DARE 24219: Olympia Stadium",
        "Gansera-Blum 2014 ",
        "MANTO 10214997: the Stadium at Olympia",
        "ToposText Stadium (Olympia) 25 Olympia excavations - στάδιον",
        "Wikidata Stadium at Olympia (Q4357227)",
        "Wikipedia (Greek) Στάδιο Αρχαίας Ολυμπίας",
        "vici.org 17796: Stadion, Olympia";
    dcterms:contributor <https://pleiades.stoa.org/author/acampbell>,
        <https://pleiades.stoa.org/author/bkiesling>,
        <https://pleiades.stoa.org/author/ghawes>,
