    dcterms:contributor <https://pleiades.stoa.org/author/sgillies>,
        <https://pleiades.stoa.org/author/thomase>;
    dcterms:creator <https://pleiades.stoa.org/author/jbecker>;
    dcterms:description "A church in Trastevere with origins in the fifth century CE. Pope Urban I likely founded the first church on the same site in the third century CE. Its venerated saint is a Christian martyr of the third century CE. Pope Paschal I rebuilt the church in 822 CE, and moved the relics of St Cecilia to the site from the Catacombs of San Callisto on the Via Appia.";
    dcterms:modified "2026-07-31T10:01:51-04:00";
    dcterms:subject "paleochristian";
    dcterms:title "Santa Cecilia in Trastevere";
