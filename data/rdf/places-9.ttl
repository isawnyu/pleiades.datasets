    dcterms:contributor <https://pleiades.stoa.org/author/thomase>;
    dcterms:creator <https://pleiades.stoa.org/author/jbecker>;
    dcterms:description "The sanctuary along the Decumanus Maximus of Ostia known as the \"Quattro tempietti\" dates from the Republican period. Based on multiple phases of restoration, they continued in use until at least the second century CE. Epigraphic evidence leads some scholars to conclude that the four temples were sacred to Venus, Fortuna, Ceres, and Spes and had been dedicated by one Publius Lucilius Gamala.";
    dcterms:modified "2025-11-25T12:49:48-04:00";
    dcterms:title "Quattro tempietti";
    cito:citesAsEvidence <https://www.zotero.org/groups/pleiades/items/JCY8WN8B>;
    cito:citesForInformation <https://poj.peeters-leuven.be/content.php?url=article&id=3286782>,
        <https://www.ostia-antica.org/regio2/8/8-2.htm>,
        <https://www.persee.fr/doc/mefr_0223-5102_1973_num_85_2_957>,
