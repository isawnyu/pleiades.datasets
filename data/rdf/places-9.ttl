<https://pleiades.stoa.org/places/916776658> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "Angle 2012 ",
        "Ashby 1902 p. 236",
        "Risorse alimentari e aspetti rituali della comunità eneolitica di Pantano Borghese (Montecompatri, Roma) ";
    dcterms:creator <https://pleiades.stoa.org/author/jbecker>;
    dcterms:description "The estate (tenuta) of Pantano Borghese is one of the oldest land holdings in the Agro Romano and was acquired by the Colonna family in 1613. Much of this low-lying area was once marshland at the margins of the crater lakes of this part of Latium. Thomas Ashby's work on the Roman Campagna documented numerous archaeological and epigraphical remains in this zone, including extensive remains of Roman villas.";
    dcterms:modified "2026-05-14T11:22:59-04:00";
    dcterms:title "Pantano Borghese";
    cito:citesForInformation <https://www.cambridge.org/core/journals/papers-of-the-british-school-at-rome/article/classical-topography-of-the-roman-campagnai/E3E23DDC5640C364F3DDF7C9DECD958E>,
        <https://www.zotero.org/groups/pleiades/items/7KJTCY5V>,
        <https://www.zotero.org/groups/pleiades/items/GZJ9LTG8>;
    owl:sameAs <http://pleiades.stoa.org/places/916776658>;
    skos:inScheme <https://pleiades.stoa.org/places>;
    prov:wasDerivedFrom [ rdfs:label "Pleiades" ];
