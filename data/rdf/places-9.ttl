<https://pleiades.stoa.org/places/912953/name.2018-01-11.2918449251> dcterms:contributor <https://pleiades.stoa.org/author/jbecker>,
        <https://pleiades.stoa.org/author/thomase>;
    dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "City in Bit-Yakin. The Neo-Babylonian king (re)built the temple Eamaškuga, the temple of the goddess Ningal. The identification of Tell al-Lahm with Kissik is based on the discovery of an inscribed clay cylinder of Nabonidus that mentions work at Kissik.";
    dcterms:modified "2026-02-12T12:21:58-04:00";
    dcterms:subject "ANE";
    dcterms:title "Kissik";
