    dcterms:title "Aequanus Pagus";
    cito:citesAsEvidence <https://db.edcs.eu/epigr/epi_url.php?s_sprache=de&p_publication=CIL+10,+00407>;
    cito:citesForInformation <http://www.worldcat.org/oclc/43970336>,
        <https://de.wikisource.org/wiki/RE:Aequanus_pagus_1%23I,1>,
        <https://www.jstor.org/stable/20859068>,
        <https://www.zotero.org/groups/pleiades/items/9377UUFB>;
