    dcterms:modified "2021-02-02T19:29:41-04:00";
    dcterms:subject "ANE",
        "Babylonian";
    dcterms:title "bīt Sîn";
    owl:sameAs <http://pleiades.stoa.org/places/454450226/bit-sin> .

<https://pleiades.stoa.org/places/454450226/egisnugal> dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "The Sumerian ceremonial name Ekišnugal is sometimes Egišnugal, which also means “House of the Great Light.”";
