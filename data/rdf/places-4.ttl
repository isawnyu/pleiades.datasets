    dcterms:title "bīt Šarrat-Larsa";
    owl:sameAs <http://pleiades.stoa.org/places/454450225/bit-sarrat-larsa> .

<https://pleiades.stoa.org/places/454450225/emekiliburur> dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "The Sumerian ceremonial name Emekiliburur means “House which Gathers All the Me’s.”";
    dcterms:modified "2021-02-02T19:30:05-04:00";
    dcterms:subject "ANE",
