        <https://www.wikidata.org/wiki/Q277486>;
    cito:citesForInformation <http://www.worldcat.org/oclc/35168496>,
        <http://www.worldcat.org/oclc/43970336>,
        <https://en.wikipedia.org/wiki/Duronia>;
