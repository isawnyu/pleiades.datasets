    dcterms:bibliographicCitation "BAtlas 5 E3 Dandagula/Paloura",
        "Dayalan 2019 page 50 see \"Palur\"",
        "Gerini 1909 page 743 see \"p. 47 ll. 7-9 Palūra\" and page 47",
        "Law 1976 pages 149 and 159",
        "Plin., NH (Mayhoff: PHI) 6.72.6",
        "Ptol (Müller: Hathi Trust) 1.13.4-6 (page 35)",
        "Ptol. (Renou; IA) 7.1.16 (page 9)",
        "Ptol. (Renou; IA) page 85",
        "Saikumar 2010 ",
        "Wikidata Dantapuram (Q5221123)",
        "Wikipedia (Telugu) దంతపురి";
    dcterms:contributor <http://darmc.harvard.edu>,
        <http://viaf.org/viaf/59162760>,
        <https://pleiades.stoa.org/author/jbecker>,
        <https://pleiades.stoa.org/author/sgillies>,
