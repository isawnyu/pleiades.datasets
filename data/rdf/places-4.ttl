    pleiades:hasName <https://pleiades.stoa.org/places/bit-samas>,
        <https://pleiades.stoa.org/places/edikukalama> .

<https://pleiades.stoa.org/places/419907821%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "House of Apollo";
    spatial:C <https://pleiades.stoa.org/places/433032%23this>,
        <https://pleiades.stoa.org/places/984330151%23this>;
    rdfs:comment "Located on the Via di Mercurio, the so-called House of Apollo draws its name from a cycle of frescoes of the myth of Apollo found at the rear of the garden. One M. Herenullius Communis, whose name appears on a ring found in 1830, may have been the owner (VI, 7, 23).";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/419907821> .

