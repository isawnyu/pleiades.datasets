    spatial:C <https://pleiades.stoa.org/places/21574678%23this>,
        <https://pleiades.stoa.org/places/423025%23this>,
        <https://pleiades.stoa.org/places/697163696%23this>;
    rdfs:comment "The Aqua Claudia was one of the four great aqueducts of the ancient city of Rome. It was begun by Caius in A.D. 38 and completed by Claudius in A.D. 52.";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/423563> .

