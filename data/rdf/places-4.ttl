<https://pleiades.stoa.org/places/413013%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Amiternum";
    spatial:C <https://pleiades.stoa.org/places/18271457%23this>,
        <https://pleiades.stoa.org/places/23219358%23this>,
        <https://pleiades.stoa.org/places/413746%23this>,
        <https://pleiades.stoa.org/places/416870%23this>,
        <https://pleiades.stoa.org/places/785536582%23this>,
        <https://pleiades.stoa.org/places/900977729%23this>,
        <https://pleiades.stoa.org/places/926033983%23this>;
    rdfs:comment "Amiternum was an ancient settlement of the Sabines that Rome captured in 293 BC. The settlement was situated at the intersection of four Roman roads: the Via Caecilia, the Via Claudia Nova, and the two branches of the Via Salaria. The historian Sallust was born at Amiternum in 86 B.C.";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/413013> .

