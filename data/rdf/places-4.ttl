<https://pleiades.stoa.org/places/423013%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Praeneste";
    spatial:C <https://pleiades.stoa.org/places/426617%23this>,
        <https://pleiades.stoa.org/places/622606468%23this>,
        <https://pleiades.stoa.org/places/678434580%23this>,
        <https://pleiades.stoa.org/places/69910488%23this>,
        <https://pleiades.stoa.org/places/7963799%23this>;
    rdfs:comment "An ancient city of central Italy, the eighth and seventh century B.C. origins of which demonstrate high-level trade contact with the Eastern Mediterranean world. The city withdrew from the Latin League (499 B.C.) and opposed Rome in the Latin war; Cincinnatus eventually subdued Praeneste. Sulla founded a new colony there in the first century B.C.";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/423013> .

