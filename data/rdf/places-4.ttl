    dcterms:bibliographicCitation "BAtlDir p. 659 s.v. \"Unlocated Toponyms\"",
        "BAtlas 44 *Aequanus Pagus",
        "EDCS 11400491 = CIL 10.407",
        "Ferrua 1957 p. 442",
        "RE Aequanus pagus 1 (C. Hülsen)";
    dcterms:contributor <http://viaf.org/viaf/59162760>,
        <https://pleiades.stoa.org/author/jbecker>,
        <https://pleiades.stoa.org/author/sgillies>,
        <https://pleiades.stoa.org/author/thomase>;
    dcterms:coverage "Volcei";
    dcterms:creator <http://viaf.org/viaf/24617478>;
    dcterms:description "Now unlocated, *Aequanus Pagus was a place in ancient Italy. It was included on map 44 of the Barrington Atlas. Based on the entry in Pauly-Wissowa, N. Purcell includes this place and indicates it as belonging to the territory of Volcei. This corresponds with the RE contention that is based upon a Latin inscription (CIL 10, 407) that dates to 323 CE. Ferrua (1957) comments on the homonymous places called Aequanus Pagus that nonetheless seem to be distinct.";
