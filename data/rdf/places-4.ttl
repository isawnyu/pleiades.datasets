<https://pleiades.stoa.org/places/454450225%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Emekiliburur";
    spatial:C <https://pleiades.stoa.org/places/5066375%23this>,
        <https://pleiades.stoa.org/places/893951%23this>;
    rdfs:comment "The temple of the goddess Šarrat-Larsa, Emekiliburur (“House which Gathers All the Me’s”), was located in the Kullab district of Babylon, in the eastern half of the inner city. According to the Babylonian topographical text Tintir = Babylon Tablet IV, it was one of four temples in that part of Babylon.";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/454450225> .

<https://pleiades.stoa.org/places/454450225/bit-sarrat-larsa> dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "Everyday Akkadian name of “the temple of the goddess Šarrat-Larsa” (Emekiliburur).";
    dcterms:modified "2021-02-02T19:30:05-04:00";
    dcterms:subject "ANE",
