<https://pleiades.stoa.org/places/481246816> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "ATAE Assur 45 (N 30) ",
        "Pedersén 1986 124–125",
        "Pedersén 1998 142";
    dcterms:contributor <https://pleiades.stoa.org/author/ptushingham>;
    dcterms:creator <https://pleiades.stoa.org/author/tseidler>;
    dcterms:description "In a private house in dE9V above the ruined gate to the inner town wall, probably House 1 or just nearby, excavators discovered an archive of some 15 clay tablets. The majority of datings are from 707 to 681 BC, except for one dating: postcanonical 639* BC. The archive includes multiple documents concerning loans, as well as a letter and a purchase document.";
    dcterms:modified "2023-05-11T12:32:17-04:00";
    dcterms:subject "ANE",
        "Assyrian";
    dcterms:title "Assur Archive 45";
    cito:citesForInformation <http://oracc.museum.upenn.edu/atae/assur_045>,
        <http://uu.diva-portal.org/smash/get/diva2:88568/FULLTEXT01.pdf>,
        <https://www.zotero.org/groups/pleiades/items/2FXZ7SLX>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/893945>;
    owl:sameAs <http://pleiades.stoa.org/places/481246816>;
    skos:altLabel "Assur Archive 45"@en,
        "N 30 Archive"@en;
    skos:inScheme <https://pleiades.stoa.org/places>;
    prov:wasDerivedFrom [ rdfs:label "Pleiades" ];
