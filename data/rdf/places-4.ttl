<https://pleiades.stoa.org/places/438827> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "BAtlas 44 Satricum",
        "Nissen II 674";
    dcterms:contributor <http://viaf.org/viaf/59162760>,
        <https://pleiades.stoa.org/author/jbecker>,
        <https://pleiades.stoa.org/author/sgillies>,
        <https://pleiades.stoa.org/author/thomase>;
    dcterms:coverage "of the Volsci";
    dcterms:creator <http://viaf.org/viaf/24617478>;
    dcterms:description "This unlocated place, named Satricum, is included on map 44 of the Barrington Atlas. N. Purcell cites Nissen, which leads to a citation from a letter written by M. Tullius Cicero to his brother, Quintus Tullius Cicero. The former is travelling by road and has been at Laterium, where he observed a small bridge and a temple sacred to Furina. In his discussion of distance and road conditions, he mentions the toponym Satricum as being further along the road than the shrine.";
    dcterms:modified "2026-07-06T12:31:15-04:00";
    dcterms:title "Satricum";
    cito:citesForInformation <http://www.worldcat.org/oclc/43970336>,
        <https://link.gale.com/apps/doc/CXWWNE753554551/NCCO?u=new64731&sid=bookmark-NCCO&xid=fc884f52&pg=1>;
