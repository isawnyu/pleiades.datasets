<https://pleiades.stoa.org/places/413306%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Sarsina";
    spatial:C <https://pleiades.stoa.org/places/393490%23this>,
        <https://pleiades.stoa.org/places/791853466%23this>,
        <https://pleiades.stoa.org/places/791853467%23this>;
    rdfs:comment "Sarsina was a town of the Umbri that was captured by Cornelius Scipio in 271 B.C. and was the birthplace of the Latin author Plautus. The necropolis at Sarsina has been extensively studied.";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/413306> .

