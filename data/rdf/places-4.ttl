<https://pleiades.stoa.org/places/425217700%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "House of the Arrhephoroi";
    spatial:C <https://pleiades.stoa.org/places/517288793%23this>,
        <https://pleiades.stoa.org/places/638356144%23this>,
        <https://pleiades.stoa.org/places/750203268%23this>;
    rdfs:comment "A house on the Acropolis of Athens, the residence of the Arrheporoi ('bearers of unspoken things'), two girls, who helped weave Athena's cloak for the Panathenaia festival and carried a box containing the 'unspoken things' down from the Acropolis to a precinct near the sanctuary of Aphrodite in the Gardens during the Arrhephoria festival. The house is possibly to be identified with Building III on the Acropolis.";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/425217700> .

