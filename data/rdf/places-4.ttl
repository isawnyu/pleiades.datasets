        <https://doi.org/10.1163/1574-9347_dnp_e811230>,
        <https://www.perseus.tufts.edu/hopper/text?doc=Perseus:text:1999.04.0064:entry=mugilla-geo&highlight=mugilla>,
        <https://www.zotero.org/groups/pleiades/items/9QBXHJUP>,
        <https://www.zotero.org/groups/pleiades/items/N47ZI37I>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/422958>;
    owl:sameAs <http://pleiades.stoa.org/places/426618>;
