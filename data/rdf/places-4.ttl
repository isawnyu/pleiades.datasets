<https://pleiades.stoa.org/places/452758807%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Egišhurankia";
    spatial:C <https://pleiades.stoa.org/places/202833933%23this>,
        <https://pleiades.stoa.org/places/633091638%23this>,
        <https://pleiades.stoa.org/places/633091640%23this>,
        <https://pleiades.stoa.org/places/893951%23this>;
    rdfs:comment "The temple of the goddess Bēlet-Ninūa, Egišhurankia (“House of the Ordinances of Heaven and Underworld”), was located in the Bāb-Lugalerra district of Babylon, in the western half of the inner city. According to the Babylonian topographical text Tintir = Babylon Tablet IV, it was one of three temples in that part of Babylon. Egišhurankia seems to have been located near Imgur-Enlil, along the northern wall.";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/452758807> .

<https://pleiades.stoa.org/places/452758807/bit-belet-ninua> dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "Everyday Akkadian name of “the temple of the goddess Bēlet-Ninūa” (Egišhurankia).";
    dcterms:modified "2021-01-31T09:49:40-04:00";
    dcterms:subject "ANE",
        "Babylonian";
    dcterms:title "bīt Bēlet-Ninūa";
    owl:sameAs <http://pleiades.stoa.org/places/452758807/bit-belet-ninua> .

<https://pleiades.stoa.org/places/452758807/egishurankia> dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "The Sumerian ceremonial name Egišhurankia means “House of the Ordinances of Heaven and Underworld.”";
    dcterms:modified "2021-01-31T09:49:40-04:00";
    dcterms:subject "ANE",
