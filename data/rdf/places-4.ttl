    dcterms:bibliographicCitation "",
        "Frere 1983 48, 50-51",
        "Frere et al. 1974 ",
        "HEListing 1006834: Longthorpe Roman fort and settlement",
        "PastScape Monument no. 364099",
        "RBrit Longthorpe Vexillation Fort",
        "St. Joseph 1965 p.74 & fig.1",
        "Wikidata Longthorpe (Samian Ware Discovery Site) (Q103177589)",
