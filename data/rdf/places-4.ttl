<https://pleiades.stoa.org/places/480919150> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "Barnett and Falkner 1962 ",
        "Oates 2004 74–77",
        "RLAss Kalhu §22",
        "Russell 1995 ";
    dcterms:contributor <https://pleiades.stoa.org/author/jbecker>;
    dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "The seventh-century-BC Assyrian king Esarhaddon (r. 680–669 BC) started building a royal residence in the southwest corner of the citadel of Kalhu (biblical Calah, modern Nimrud). Sculpted and inscribed limestone slabs from the Central Palace (constructed by Tiglath-pileser III [r. 744–727 BC]) and the Northwest Palace (built by Ashurnasirpal II [r. 883–859 BC]) were used as building materials for this royal residence, which very likely remained unfinished at the time of Esarhaddon’s death in 669 BC. Its excavators called it the “Southwest Palace” since it was located in the southwest corner of the citadel.";
    dcterms:modified "2021-01-18T11:41:48-04:00";
    dcterms:subject "ANE",
        "Assyrian";
    dcterms:title "Southwest Palace at Kalhu";
    cito:citesForInformation <https://www.jstor.org/stable/4200403>,
        <https://www.worldcat.org/oclc/1075376371>,
        <https://www.zotero.org/groups/pleiades/items/LCUKSJKD>,
        <https://www.zotero.org/groups/pleiades/items/S55JVIUS>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/439136375>,
        <https://pleiades.stoa.org/places/480919151>,
        <https://pleiades.stoa.org/places/894019>;
    owl:sameAs <http://pleiades.stoa.org/places/480919150>;
    skos:altLabel "Southwest Palace, South-West Palace"@en,
        "ēkal Aššur-aḫu-iddina"@akk;
