<https://pleiades.stoa.org/places/423064%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Mausoleum of Caecilia Metella";
    spatial:C <https://pleiades.stoa.org/places/156802663%23this>,
        <https://pleiades.stoa.org/places/356966898%23this>,
        <https://pleiades.stoa.org/places/390922209%23this>,
        <https://pleiades.stoa.org/places/811119037%23this>;
    rdfs:comment "A tomb on the Via Appia south of Rome belonging to Caecilia Metella, a daughter of Metellus Creticus. She was born ca. 100 BC. In 1303, the tomb was incorporated into the Castrum Caetani, serving as the main tower of the fortification.";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/423064> .

