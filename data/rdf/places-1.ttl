    dcterms:title "OSM location of Arch of Drusus";
    owl:sameAs <http://pleiades.stoa.org/places/182591943/location-of-arch-of-drusus> .

<https://pleiades.stoa.org/places/182609762%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Walls of Trabzon";
    spatial:C <https://pleiades.stoa.org/places/857359%23this>;
    rdfs:comment "A series of fortification walls that surround Trabzon in northeastern Turkey and are referred to as \"Walls of Trabzon\". This fortification is sometimes referred to as the Trabzon Castle (Turkish: Trabzon Kalesi), although it did not serve as such.";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/182609762> .

