<https://pleiades.stoa.org/places/130405659> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "BTTo Tintir IV",
        "George 1992 16–18, 20 fig. 3, 24 fig. 4, 329–330",
        "George 2004 129–130 no. 839",
        "RIBo Babylon 7 Nebuchadnezzar II 002";
    dcterms:contributor <https://pleiades.stoa.org/author/jbecker>;
    dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "The temple of the god Adad, Enamhe (“House of Plenty”), was located in the Kumar district of Babylon, in the western half of the inner city. According to the Babylonian topographical text Tintir = Babylon Tablet IV, it was one of seven temples in that part of Babylon. Enamhe was (re)built by the the Old Babylonian kings Sūmû-lā-El (r. ca. 1881–1845 BC) and Hammu-rāpi (r. ca. 1792–1750 BC) and the Neo-Babylonian ruler Nebuchadnezzar II (r. 604–562 BC).";
    dcterms:modified "2021-02-03T11:47:28-04:00";
    dcterms:subject "ANE",
        "Babylonian";
    dcterms:title "Enamhe";
    cito:citesAsEvidence <http://oracc.museum.upenn.edu/btto/Q000305>,
        <http://oracc.museum.upenn.edu/ribo/babylon7/Q005473>;
    cito:citesForInformation <http://www.worldcat.org/oclc/803804468>,
        <http://www.worldcat.org/oclc/883572295>;
