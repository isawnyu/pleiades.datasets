    dcterms:modified "2021-02-04T11:25:52-04:00";
    dcterms:subject "ANE",
        "Babylonian";
    dcterms:title "bīt Bēl-mātāti";
    owl:sameAs <http://pleiades.stoa.org/places/117946902/bit-bel-matati> .

