    dcterms:creator <http://viaf.org/viaf/19802204>,
        <http://viaf.org/viaf/93262206>;
    dcterms:description "Named inferred from the epithet of Mercury inscribed on various objects in the \"Berthouville treasure.\"";
    dcterms:modified "2018-09-25T15:50:51-04:00";
    dcterms:title "Canetonum";
    owl:sameAs <http://pleiades.stoa.org/places/108852/canetonum> .

