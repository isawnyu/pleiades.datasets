<https://pleiades.stoa.org/places/104777481> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "Mendels 1984 ",
        "New Pauly Supplement I - Volume 3 : Historical Atlas of the Ancient World, s.v. \"The Greek Leagues\"",
        "Wikidata Aetolian League (Q245273)",
        "Wikipedia (English) Aetolian League";
    dcterms:contributor <https://pleiades.stoa.org/author/jbecker>,
        <https://pleiades.stoa.org/author/thomase>;
    dcterms:creator <https://pleiades.stoa.org/author/rmhorne>;
    dcterms:description "Based in Aetolia in central Greece, the Aetolian League was founded in the Hellenistic period to counter the power of Macedon and the Achaean League. It was allied with Rome in the First Macedonian War (215-205 BCE), but later was opposed to the republic in Rome's war against Antiochos (192–188 BCE). After Rome's victory in 188, the Aetolian League was fully subordinate to Rome.";
    dcterms:modified "2024-11-26T10:39:23-04:00";
    dcterms:title "Aetolian League";
    cito:citesAsRelated <https://referenceworks.brillonline.com/entries/brill-s-new-pauly-supplements-i-3/the-greek-leagues-BNPA100>,
