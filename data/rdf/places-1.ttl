<https://pleiades.stoa.org/places/110816878> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "Pedersén 1987 155–158";
    dcterms:creator <https://pleiades.stoa.org/author/tseidler>;
    dcterms:description "Three tiers of niches were found in Room H 5 (on the northwestern side of Forecourt I) of the Nabû temple at Dur-Šarrukin, the short-lived capital of the Assyrian king Sargon II (721–705 BC). Fragments of clay tablets and inscribed prisms in these niches suggest that a temple library was located here. The empty niches might be a result of the move of the capital to Nineveh under Sennacherib (704–681 BC) or of the use of perishable writing materials.";
    dcterms:modified "2023-03-22T04:20:47-04:00";
    dcterms:subject "ANE",
        "Assyrian";
    dcterms:title "Dur-Šarrukin Archive 1";
    cito:citesForInformation <http://uu.diva-portal.org/smash/get/diva2:88568/FULLTEXT01.pdf>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/508774533>,
        <https://pleiades.stoa.org/places/785467779>,
        <https://pleiades.stoa.org/places/874458>;
    owl:sameAs <http://pleiades.stoa.org/places/110816878>;
    skos:altLabel "Dur-Šarrukin Archive 1"@en;
    skos:inScheme <https://pleiades.stoa.org/places>;
