<https://pleiades.stoa.org/places/301732141%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Palace of Ashurbanipal";
    spatial:C <https://pleiades.stoa.org/places/179295730%23this>,
        <https://pleiades.stoa.org/places/185814199%23this>,
        <https://pleiades.stoa.org/places/287060405%23this>,
        <https://pleiades.stoa.org/places/310869662%23this>,
        <https://pleiades.stoa.org/places/331679526%23this>,
        <https://pleiades.stoa.org/places/516671863%23this>,
        <https://pleiades.stoa.org/places/588149003%23this>,
        <https://pleiades.stoa.org/places/746845410%23this>,
        <https://pleiades.stoa.org/places/763257295%23this>,
        <https://pleiades.stoa.org/places/767860328%23this>,
        <https://pleiades.stoa.org/places/828352080%23this>,
        <https://pleiades.stoa.org/places/843388270%23this>,
        <https://pleiades.stoa.org/places/874621%23this>;
    rdfs:comment "The Neo-Assyrian king Ashurbanipal built a grand royal residence in the citadel of Nineveh. It was located north and east of the temples of the god Nabû (Ezida) and the goddess Ištar (Emašmaš), and it was constructed on the site of an older, smaller palace. Ashurbanipal referred to this palace as the bīt redûti (\"House of Succession\"); in scholarly literature, it is often referred to as the \"North Palace.\" A small portion of the once-grand Assyrian palace is still visible today.";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/301732141> .

<https://pleiades.stoa.org/places/303354808> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "Oates 2004 70, 72 fig. 41",
        "RLAss Kalhu §20",
        "Reade 2011 116–117";
    dcterms:contributor <https://pleiades.stoa.org/author/jbecker>;
    dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "This ornately-decorated, elevated building might have been the residence of Sammu-ramat (the legendary Semiramis) in the palace of her son Adad-nārārī III (r. 810-783 BC) at Kalhu (biblical Calah, modern Nimrud). Because these rooms were built noticeably higher than the surrounding area, its first excavator Austen Henry Layard believed that he had uncovered part of an upper floor of an Assyrian palace and, therefore, referred to this area as the “Upper Chambers.”";
    dcterms:modified "2021-01-19T10:51:07-04:00";
    dcterms:subject "ANE",
        "Assyrian";
    dcterms:title "Upper Chambers at Kalhu";
    cito:citesForInformation <https://www.ucl.ac.uk/sargon/downloads/reade_mesopotamia_46_2011.pdf>,
        <https://www.zotero.org/groups/pleiades/items/LCUKSJKD>,
        <https://www.zotero.org/groups/pleiades/items/S55JVIUS>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/309437155>,
        <https://pleiades.stoa.org/places/439136375>,
        <https://pleiades.stoa.org/places/480919151>,
        <https://pleiades.stoa.org/places/894019>;
    owl:sameAs <http://pleiades.stoa.org/places/303354808>;
    skos:altLabel "Upper Chambers"@en;
    skos:inScheme <https://pleiades.stoa.org/places>;
    prov:wasDerivedFrom [ rdfs:label "Pleiades" ];
    pleiades:hasFeatureType <https://pleiades.stoa.org/vocabularies/palace>;
    pleiades:hasLocation <https://pleiades.stoa.org/places/representative-location-of-the-upper-chambers>;
    pleiades:hasName <https://pleiades.stoa.org/places/upper-chambers> .

