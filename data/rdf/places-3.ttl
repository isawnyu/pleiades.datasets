<https://pleiades.stoa.org/places/337294882%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "East Building";
    spatial:C <https://pleiades.stoa.org/places/710563473%23this>,
        <https://pleiades.stoa.org/places/807514119%23this>;
    rdfs:comment "A building in the southeastern corner of the Athenian Agora, built in the mid-second century BC as the eastern side of the South Square complex and its main entrance from the Panathenaic Way. It was destroyed in the Sullan Sack of 86 BC, but repaired in the Imperial Period.";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/337294882> .

