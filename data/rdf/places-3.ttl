    dcterms:bibliographicCitation "WHTL 5308: Rabati Malik Caravanserai",
        "Wikidata Rabati Malik Caravanserai (Q4386673)",
        "Wikipedia (English) Rabati Malik";
    dcterms:contributor <https://pleiades.stoa.org/author/rmhorne>;
    dcterms:creator <https://pleiades.stoa.org/author/jbecker>;
    dcterms:description "An eleventh-century caravanserai along the Silk Road, now located in Uzbekistan. Rabati Malik Caravanserai was built under Karakhanid Shams-al-Mulk Nasr, son of Tamgachkhan Ibragim who ruled in Samarkand from 1068 to 1080. The site was added to the UNESCO World Heritage Tentative List in 2008.";
    dcterms:modified "2024-12-22T17:59:35-04:00";
