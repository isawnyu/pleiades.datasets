    dcterms:contributor <http://darmc.harvard.edu>,
        <http://viaf.org/viaf/59162760>,
        <https://pleiades.stoa.org/author/bkiesling>,
        <https://pleiades.stoa.org/author/jahlfeldt>,
        <https://pleiades.stoa.org/author/jbecker>,
        <https://pleiades.stoa.org/author/sgillies>,
        <https://pleiades.stoa.org/author/thomase>,
        <https://pleiades.stoa.org/author/warner-r>;
    dcterms:coverage "Hammam-Darradji";
    dcterms:creator <http://viaf.org/viaf/19524400>;
    dcterms:description "A center for Numidian royalty, Bulla Regia first became an oppidum liberum in the reign of Augustus and then a colony under Hadrian. The site, which boasts significant archaeological remains, lies in modern Tunisia, about 5km north of the modern city of Jendouba. The site was reportedly known in the 19th century as Hammam-Darradji. Today, a small modern settlement named Aïn Babouch abuts the site (not to be confused with Babouch, which lies further north along the border with Algeria).";
    dcterms:modified "2025-09-22T17:30:15-04:00";
