        <https://en.wikipedia.org/wiki/Sippar-Amnanum>,
        <https://www.zotero.org/groups/pleiades/items/FYH6JEU2>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/511134402>,
        <https://pleiades.stoa.org/places/695490820>;
    owl:sameAs <http://pleiades.stoa.org/places/392373882>;
