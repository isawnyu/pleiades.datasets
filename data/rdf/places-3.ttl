    dcterms:bibliographicCitation "AAA f. 7, no. 61",
        "BAtlas 31 C3 Centenarium Aqua Frigida",
        "DARE 27135: Tala K'frida",
        "EDCS 25700428 = CIL 8.20215",
        "Leschi 1941 ",
        "Munzi et al. 2014 55-6",
