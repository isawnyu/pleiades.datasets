<https://pleiades.stoa.org/places/344172035%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Khorsabad Citadel Gate B";
    spatial:C <https://pleiades.stoa.org/places/237150019%23this>,
        <https://pleiades.stoa.org/places/748147227%23this>,
        <https://pleiades.stoa.org/places/748147228%23this>,
        <https://pleiades.stoa.org/places/874458%23this>;
    rdfs:comment "This decorated gate was the principal entrance to the citadel of Dūr-Šarrukīn (\"Fort Sargon\"), the capital of the Assyrian Empire constructed by Sargon II (r. 721–705 BC).";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/344172035> .

<https://pleiades.stoa.org/places/344172035/citadel-gate-b> dcterms:contributor <https://pleiades.stoa.org/author/jbecker>;
    dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "The modern name assigned to the principal gate of Dūr-Šarrukīn's citadel. The ancient name of the gate is not known, but it has been suggested that it was the Anu Gate.";
