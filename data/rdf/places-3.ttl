    rdfs:label "Thelepte";
    spatial:C <https://pleiades.stoa.org/places/328444%23this>,
        <https://pleiades.stoa.org/places/338248%23this>;
    rdfs:comment "Thelepte was a Roman city in Africa Byzacena. It achieved municipal status perhaps in the time of Vespasian and became a colonia under Trajan. The city played an important administrative role in fourth century AD north Africa.";
