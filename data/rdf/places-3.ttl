    dcterms:bibliographicCitation "AAA 16.6",
        "AAA 7.12.19",
        "BAtlas 31 B3 Sava fl./Nasabath fl.",
        "Wikidata Q30688573: Bou Sellam River";
    dcterms:contributor <http://viaf.org/viaf/59162760>,
        <https://pleiades.stoa.org/author/jbecker>,
        <https://pleiades.stoa.org/author/sgillies>,
        <https://pleiades.stoa.org/author/thomase>,
        <https://pleiades.stoa.org/author/warner-r>;
    dcterms:coverage "Oued bou Sellam/Oued Summam";
    dcterms:creator <http://viaf.org/viaf/56622759>;
    dcterms:description "An ancient river of Mauretania. Gsell (whence BAtlas) argues that the name Nasabath (provided by Ptolemy) corresponds to the modern Oued Soummam, which empties into the Mediterranean just south of the ancient site of Saldae (modern Béjaïa, Algeria). Other contemporary testimony makes clear this river also bore the name Sava and that this name extended upstream to include the modern Oued Bou Sellam, one of the two major tributaries (together with the Oued Sahel = ancient Phoimios) of the Oued Soummam.";
    dcterms:modified "2025-04-28T20:46:41-04:00";
    dcterms:title "Sava fl./Nasabath fl.";
    cito:citesAsRelated <https://www.wikidata.org/wiki/Q30688573>;
    cito:citesForInformation <http://bibliotheque-numerique.inha.fr/viewer/21113/?%23page=1&viewer=picture>,
        <http://www.worldcat.org/oclc/43970336>,
        <https://bibliotheque-numerique.inha.fr/viewer/21113/?%23page=58&viewer=picture&o=bookmark&n=0&q=>;
    owl:sameAs <http://pleiades.stoa.org/places/305148>;
