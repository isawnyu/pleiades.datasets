<https://pleiades.stoa.org/places/301732141> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "Barnett 1976 ",
        "RINAP 5 Ashurbanipal 009 (Q003708)",
        "RINAP 5 Ashurbanipal 011 (Q003710)",
        "RLAss 9 416-418",
        "Wikipedia (English) Ashurbanipal",
        "Wikipedia (English) Nineveh";
    dcterms:contributor <https://pleiades.stoa.org/author/jbecker>;
    dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "The Neo-Assyrian king Ashurbanipal built a grand royal residence in the citadel of Nineveh. It was located north and east of the temples of the god Nabû (Ezida) and the goddess Ištar (Emašmaš), and it was constructed on the site of an older, smaller palace. Ashurbanipal referred to this palace as the bīt redûti (\"House of Succession\"); in scholarly literature, it is often referred to as the \"North Palace.\" A small portion of the once-grand Assyrian palace is still visible today.";
    dcterms:modified "2018-02-09T15:07:31-04:00";
    dcterms:subject "ANE";
    dcterms:title "Palace of Ashurbanipal";
    cito:citesForInformation <http://oracc.museum.upenn.edu/rinap/rinap5/Q003708>,
        <http://oracc.museum.upenn.edu/rinap/rinap5/Q003710>,
        <https://en.wikipedia.org/wiki/Ashurbanipal>,
        <https://en.wikipedia.org/wiki/Nineveh>,
        <https://www.worldcat.org/oclc/265452711>,
        <https://www.zotero.org/groups/pleiades/items/LCUKSJKD>;
