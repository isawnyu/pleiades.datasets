<https://pleiades.stoa.org/places/376850631%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Horti Maiani";
    spatial:C <https://pleiades.stoa.org/places/406470991%23this>,
        <https://pleiades.stoa.org/places/423025%23this>;
    rdfs:comment "An urban garden of imperial Rome located on the summit of the Esquiline Hill. Based on an inscription dating to the reign of Claudius, it is believed that these gardens were administered by the same magistrate in charge of the Horti Lamiani, an official with the title \"procurator hortorum Maianorum et Lamianorum\".";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/376850631> .

<https://pleiades.stoa.org/places/376850631/horti-maiani> dcterms:contributor <https://pleiades.stoa.org/author/thomase>;
