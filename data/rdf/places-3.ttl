<https://pleiades.stoa.org/places/33309869%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Ay-ibūr-šabû";
    spatial:C <https://pleiades.stoa.org/places/142907963%23this>,
        <https://pleiades.stoa.org/places/213534097%23this>,
        <https://pleiades.stoa.org/places/223617668%23this>,
        <https://pleiades.stoa.org/places/251337021%23this>,
        <https://pleiades.stoa.org/places/452038953%23this>,
        <https://pleiades.stoa.org/places/54136919%23this>,
