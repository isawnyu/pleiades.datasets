        <https://www.megalithic.co.uk/article.php?sid=33161>,
        <https://www.zotero.org/groups/pleiades/items/2ZYHNRC9>,
        <https://www.zotero.org/groups/pleiades/items/VGZYW2LU>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/570182>;
