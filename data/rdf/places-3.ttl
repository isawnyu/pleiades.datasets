    dcterms:modified "2023-05-11T12:53:27-04:00";
    dcterms:subject "ANE",
        "Assyrian";
    dcterms:title "Plan location of Til–Barsip Archive 1";
    owl:sameAs <http://pleiades.stoa.org/places/378114381/plan-location-of-til2013barsip-archive-1> .

