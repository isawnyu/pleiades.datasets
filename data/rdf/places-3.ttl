<https://pleiades.stoa.org/places/325705845%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Unnamed island (southern Akrotiri peninsula, Cyprus)";
    spatial:C <https://pleiades.stoa.org/places/707502%23this>,
        <https://pleiades.stoa.org/places/707525%23this>,
        <https://pleiades.stoa.org/places/707547%23this>,
        <https://pleiades.stoa.org/places/707554%23this>;
    rdfs:comment "An island comprising the southern portion of the Akrotiri peninsula, separated by ocean from the southern coast of Cyprus beginning ca. 6000 BP until early modern times. Remains of the sea channel are now represented by the land-locked Limassol Salt Lake. The extent of the island corresponded roughly to the modern town of Akrotiri and the air base.";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/325705845> .

