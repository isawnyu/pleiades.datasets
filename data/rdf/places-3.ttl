    dcterms:bibliographicCitation "AAA 6.148",
        "BAtlas 31 B3 Petra",
        "Laporte 2012 pages 999-1002 see \"Annexe IV – Dédicace du praesidium Sammacis à M’lakou\"",
        "TM GEO ID 20538: Fundus Petrensis (M'lakou)",
        "Wikidata Fundus Petrensis (Q134524561)";
    dcterms:contributor <http://viaf.org/viaf/59162760>,
