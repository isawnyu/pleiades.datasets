<https://pleiades.stoa.org/places/386176625> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "Nigro 2014 ",
        "Nigro 2022 ",
        "PECS (Perseus) MOTYA (St. Pantateo) Trapani, Sicily";
    dcterms:contributor [ a <http://xmlns.com/foaf/0.1/Person>;
            foaf:name "Heidrun Wiesenmüller" ];
    dcterms:creator <https://pleiades.stoa.org/author/jbecker>,
        <https://pleiades.stoa.org/author/thomase>;
    dcterms:description "The so-called \"Kothon\" is a large, rectangular, artificial pool dating to the Punic period of Sicily and located on the island of Motya. Originally interpreted as an artificial port basin, recent research reinterpets it as a freshwater basin with functions sacred to the god Ba'al and constituting the central component of a large sanctuary.";
    dcterms:modified "2022-04-28T08:30:22-04:00";
    dcterms:subject "Ba'al";
    dcterms:title "Kothon";
    cito:citesAsRelated <http://www.perseus.tufts.edu/hopper/text?doc=Perseus:text:1999.04.0006:entry=motya>;
    cito:citesForInformation <http://www.worldcat.org/oclc/897470066>,
        <https://www.cambridge.org/core/journals/antiquity/article/sacred-pool-of-baal-a-reinterpretation-of-the-kothon-at-motya/329646E6561765FD30A9D6EC5FD5B6CB>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/462373>;
    owl:sameAs <http://pleiades.stoa.org/places/386176625>;
    skos:inScheme <https://pleiades.stoa.org/places>;
    prov:wasDerivedFrom [ rdfs:label "Pleiades" ];
