<https://pleiades.stoa.org/places/678676209%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Basilica Constantini";
    spatial:C <https://pleiades.stoa.org/places/423025%23this>,
        <https://pleiades.stoa.org/places/434423626%23this>,
        <https://pleiades.stoa.org/places/523965218%23this>,
        <https://pleiades.stoa.org/places/525081443%23this>;
    rdfs:comment "The Basilica Constantini, also referred to as Basilica Nova (\"New Basilica\"), Basilica of Maxentius or Basilica of Maxentius and Constantine, is a colossal fourth-century basilica located along the Sacra Via in Rome. It is considered the largest ancient structure in the valley of the Forum Romanum and is typically deemed the final Roman civic basilica built in the ancient city.";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/678676209> .

