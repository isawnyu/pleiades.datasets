    dcterms:bibliographicCitation "BTTo Tintir IV",
        "George 1992 331–332",
        "George 2004 137 no. 943",
        "RIBo Babylon 7 Nebuchadnezzar II 002",
        "RINAP 5 online Ashurbanipal 013";
    dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "The temple of the goddess Gula, Esabad (“House of the Open Ear”), was located in the Tuba district of Babylon, in the western half of the inner city. According to the Babylonian topographical text Tintir = Babylon Tablet IV, it was one of three temples in that part of Babylon. Esabad was rebuilt by the Assyrian king Ashurbanipal (r. 668–ca. 631 BC) and Nebuchadnezzar II (r. 604–652 BC). The temple survived into Arsacid times (247 BC–AD 224).";
    dcterms:modified "2021-01-30T12:44:30-04:00";
    dcterms:subject "ANE",
        "Babylonian";
    dcterms:title "Esabad";
    cito:citesAsEvidence <http://oracc.museum.upenn.edu/btto/Q000305>,
        <http://oracc.museum.upenn.edu/ribo/babylon7/Q005473>,
        <http://oracc.museum.upenn.edu/rinap/rinap5/Q003712>;
    cito:citesForInformation <http://www.worldcat.org/oclc/803804468>,
        <http://www.worldcat.org/oclc/883572295>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/893951>,
