<https://pleiades.stoa.org/places/605179374%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Nergal Gate";
    spatial:C <https://pleiades.stoa.org/places/874621%23this>,
        <https://pleiades.stoa.org/places/879396033%23this>,
        <https://pleiades.stoa.org/places/882947620%23this>,
        <https://pleiades.stoa.org/places/945930916%23this>;
    rdfs:comment "The northern city wall of Nineveh had three gates: the Nergal Gate was middle gate. The Neo-Assyrian king Sennacherib constructed it and gave it the Akkadian ceremonial names Erra-mušamqit-ayyābī (\"The God Erra Is the One Who Cuts Down Enemies\") and Erra-šāgiš-zāmânīya (\"The God Erra Is the One Who Cuts Down My Enemies\").";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/605179374> .

<https://pleiades.stoa.org/places/605179374/name.2018-02-03.5781192150> dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "Everyday/common Akkadian name of the gate.";
    dcterms:modified "2018-02-07T07:20:32-04:00";
