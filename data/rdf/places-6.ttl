    dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "The representative, estimated location of the gate is based on Reade, RLAss 9 (2000), 390 fig. 1, and Reade (2016), 51 (fig. 10).";
    dcterms:modified "2023-03-03T20:39:40-04:00";
    dcterms:subject "ANE";
    dcterms:title "Conjectural location of the Step Gate";
    owl:sameAs <http://pleiades.stoa.org/places/639153005/conjectural-location> .

