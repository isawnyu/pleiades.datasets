<https://pleiades.stoa.org/places/646547814%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Esabad";
    spatial:C <https://pleiades.stoa.org/places/893951%23this>,
        <https://pleiades.stoa.org/places/89975947%23this>;
    rdfs:comment "The temple of the goddess Gula, Esabad (“House of the Open Ear”), was located in the Tuba district of Babylon, in the western half of the inner city. According to the Babylonian topographical text Tintir = Babylon Tablet IV, it was one of three temples in that part of Babylon. Esabad was rebuilt by the Assyrian king Ashurbanipal (r. 668–ca. 631 BC) and Nebuchadnezzar II (r. 604–652 BC). The temple survived into Arsacid times (247 BC–AD 224).";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/646547814> .

<https://pleiades.stoa.org/places/646547814/bit-gula> dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "Everyday Akkadian name of “the temple of the goddess Gula” (Esabad).";
    dcterms:modified "2021-01-30T12:44:30-04:00";
    dcterms:subject "ANE",
        "Babylonian";
    dcterms:title "bīt Gula";
    owl:sameAs <http://pleiades.stoa.org/places/646547814/bit-gula> .

<https://pleiades.stoa.org/places/646547814/esabad> dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "The Sumerian ceremonial name Esabad means “House of the Open Ear.”";
    dcterms:modified "2021-01-30T12:44:29-04:00";
    dcterms:subject "ANE",
        "Babylonian";
    dcterms:title "Esabad";
    owl:sameAs <http://pleiades.stoa.org/places/646547814/esabad> .

<https://pleiades.stoa.org/places/646547815%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Ekitušgarza";
    spatial:C <https://pleiades.stoa.org/places/202833933%23this>,
