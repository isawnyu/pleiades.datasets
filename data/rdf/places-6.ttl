<https://pleiades.stoa.org/places/690970100%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Hippades Gate";
    spatial:C <https://pleiades.stoa.org/places/579885%23this>,
        <https://pleiades.stoa.org/places/830927276%23this>;
    rdfs:comment "A gate in the Themistoklean Wall of Athens, whose name means \"Equestrian Gate.\" It has been identified with archaeological remains (not visible) at Leokoriou and Dipylou Streets.";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/690970100> .

<https://pleiades.stoa.org/places/690970100/eriai-gate> dcterms:contributor <https://pleiades.stoa.org/author/jbecker>;
    dcterms:creator <https://pleiades.stoa.org/author/cdlisle>;
    dcterms:description "The Eriai Gate (from Ήρίαι πύλαι, \"tombs gate\") was a modern invention, derived from a misreading of the Etymologicon Magnum sv. Ἠρίαι, which says that all Athenian gates were sometimes referred to as Ήρίαι, because corpses were carried through them to the necropoleis outside the city.";
    dcterms:modified "2024-03-30T21:41:41-04:00";
    dcterms:title "Eriai Gate";
    owl:sameAs <http://pleiades.stoa.org/places/690970100/eriai-gate> .

