<https://pleiades.stoa.org/places/637347439> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "Dannell 1987 ",
        "Frere et al. 1974 ",
        "Todd 1989 ";
    dcterms:contributor <https://pleiades.stoa.org/author/jbecker>,
        <https://pleiades.stoa.org/author/thomase>;
    dcterms:creator <https://pleiades.stoa.org/author/zrosalinsky>;
    dcterms:description "A Pre-Roman Iron Age farmstead with a relatively short occupational history gave way to a Roman installation that was situated outside the confines of the first-century fort at Longthorpe near Peterborough. This installation was termed a \"works-depot\" by its excavators and shows evidence of both ceramic production and metalworking. The installation was likely established soon after the fort's own foundation in the late 40s. It is an unusual site for this period.";
    dcterms:modified "2022-06-10T06:57:46-04:00";
    dcterms:title "Longthorpe II";
    cito:citesForInformation <http://books.google.com/books?id=CKgvAAAAMAAJ>,
        <https://www.cambridge.org/core/journals/britannia/article/abs/longthorpe-ii-the-military-worksdepot-an-episode-in-landscape-history-by-gb-dannell-jp-wild-britannia-monograph-8-society-for-the-promotion-of-roman-studies-london-1987-pp-206-pls-27-figs-48-tables-19-price-1575-isbn-0-907764-8-8/E3A0E6F98CC1DC7FC170E91D1E87BD16>,
        <https://www.jstor.org/stable/525724>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/442436712>;
    owl:sameAs <http://pleiades.stoa.org/places/637347439>;
    skos:inScheme <https://pleiades.stoa.org/places>;
