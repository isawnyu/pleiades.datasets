    dcterms:coverage "Merj el-Kebir LEB";
    dcterms:creator <http://viaf.org/viaf/22153097>,
        <https://pleiades.stoa.org/author/brown-j-p>;
    dcterms:description "An ancient, marshy lake that was located in the Marsyas valley between ancient Gerra (modern Anjar in Lebanon) and the Libanus Mons. Polybius describes the general topography, including the lake, and Theophrastus mentions \"the lake in Syria where the kalamos euodēs grows\". Neither provides a proper name for the lake, but BAtlas evokes Theophrastus in creating the label \"Kalamon Limne\". The lake was drained in the 14th century CE and the general area was known in the 20th century as \"le Merdj\" (Dussaud 1927) and \"Merj el-Kebir\" (BAtlDir).";
    dcterms:modified "2026-05-28T15:05:55-04:00";
    dcterms:title "So-called Kalamon Limne";
    cito:citesAsEvidence <http://data.perseus.org/citations/urn:cts:greekLit:tlg0543.tlg001.perseus-grc1:5.45>,
        <https://archive.org/details/theophrastus-enquiry-plants-loeb/page/n371/mode/2up>;
    cito:citesAsRelated <https://elexikon.ch/RE/X,2_1541?Big>;
    cito:citesForInformation <http://www.worldcat.org/oclc/43970336>,
        <https://books.openedition.org/ifpo/3703>,
        <https://search.worldcat.org/title/45084869>;
