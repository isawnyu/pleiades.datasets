        "Bobin 2022 ",
        "CAG 35 239",
        "DARMC 23363",
        "Sanctuaire de la Chapelle-des-Fougeretz ",
        "Un remarquable ensemble cultuel gallo-romain à la Chapelle-des-Fougeretz (Ille-et-Vilaine) ";
    dcterms:contributor [ a <http://xmlns.com/foaf/0.1/Person>;
            foaf:name "David Meadows" ],
        <http://darmc.harvard.edu>,
