<https://pleiades.stoa.org/places/62810657> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "Nimrud Project 2013-2014 ",
        "Oates 2004 105–107",
        "RLAss Kalhu §10",
        "Reade 2002 ";
    dcterms:contributor <https://pleiades.stoa.org/author/jbecker>,
        <https://pleiades.stoa.org/author/thomase>;
    dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "The temple-tower of the god Ninurta, which was started by the ninth-century-BC Assyrian ruler Ashurnasirpal II (r. 883–859 BC) and completed by his son and successor Shalmaneser III (r. 858–824 BC), is still the most prominent feature of Kalhu (modern Nimrud). This multi-staged ziggurat, whose remains are now a pyramid of eroding mud-brick, was constructed in the northwest corner of the citadel, next to Kalhu's principal sanctuary, the Ninurta temple.";
    dcterms:modified "2024-08-15T16:25:46-04:00";
    dcterms:title "Kalhu ziggurat";
    cito:citesForInformation <http://oracc.museum.upenn.edu/nimrud/ancientkalhu/thecity/zigguratandtemples/index.html>,
        <https://www.jstor.org/stable/4200523>,
        <https://www.zotero.org/groups/pleiades/items/LCUKSJKD>,
        <https://www.zotero.org/groups/pleiades/items/S55JVIUS>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/439136375>,
        <https://pleiades.stoa.org/places/62810658>,
        <https://pleiades.stoa.org/places/894019>;
    owl:sameAs <http://pleiades.stoa.org/places/62810657>;
    skos:altLabel "siqqurrat Ninurta"@akk,
        "siqqurratu ša Kalhi"@akk;
    skos:inScheme <https://pleiades.stoa.org/places>;
    prov:wasDerivedFrom [ rdfs:label "Pleiades" ];
    pleiades:hasFeatureType <https://pleiades.stoa.org/vocabularies/temple-2>,
