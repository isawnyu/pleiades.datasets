    dcterms:modified "2021-09-23T18:31:05-04:00";
    dcterms:title "OSM location of Temple of Amada";
    owl:sameAs <http://pleiades.stoa.org/places/683591498/osm-location-of-temple-of-amada> .

<https://pleiades.stoa.org/places/683842488%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "San Trifone in Posterula";
    spatial:C <https://pleiades.stoa.org/places/34438602%23this>,
        <https://pleiades.stoa.org/places/423025%23this>;
    rdfs:comment "San Trifone in Posterula is a no-longer-extant titular church of Rome. It was located at the corner of Via dei Portoghesi and Via della Scrofa in the Campus Martius. The church likely originates in the eighth century; it appears in documentary records beginning in 1006. The ancient church was destroyed in 1746 when the Basilica of Sant'Agostino was enlarged.";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/683842488> .

