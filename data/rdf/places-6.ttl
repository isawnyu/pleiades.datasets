<https://pleiades.stoa.org/places/662332233%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Aqua Augusta (Naples)";
    spatial:C <https://pleiades.stoa.org/places/419672523%23this>,
        <https://pleiades.stoa.org/places/432618%23this>,
        <https://pleiades.stoa.org/places/432621%23this>,
