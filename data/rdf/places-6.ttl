        "OSM Node: Avlan (4883747251)",
        "RE Chimaira 2",
        "Wikipedia (English) Chimera (mythology)";
    dcterms:contributor <http://viaf.org/viaf/59162760>,
        <https://pleiades.stoa.org/author/jbecker>,
        <https://pleiades.stoa.org/author/sgillies>,
        <https://pleiades.stoa.org/author/thomase>;
    dcterms:coverage "Avlan valley";
    dcterms:creator <http://viaf.org/viaf/39409558>,
        <http://viaf.org/viaf/91669326>;
    dcterms:description "Strabo places the myth of the Lycian monster Chimaira in the Kragos mountains, noting a nearby chasm or ravine (φάραγξ) named after the monster that he says extends up from the shore. BAtlas 65 places the label \"Chimaera\" along the low pass between the Kragos and Antikragos, i.e., from the modern Sancaklık Koyu (where the ancient settlement of Kalabantia was located) to roughly the area of the modern village of Boğaziçi in Turkey's Seydikemer district (Muğla Province). A western neighborhood of that village, Avlan, preserves the modern name of the ravine identified in RE Kragos 1, \"Tal von Alwan\" (sic) and in BAtlDir: \"Avlan valley\".";
    dcterms:modified "2025-08-15T17:34:12-04:00";
    dcterms:title "Chimaira";
    cito:citesAsRelated <https://en.wikipedia.org/wiki/Chimera_(mythology)>,
        <https://resource.manto.unh.edu/11311160>,
        <https://www.geonames.org/322898/avlan.html>,
        <https://www.openstreetmap.org/node/4883747251>;
    cito:citesForInformation <http://www.worldcat.org/oclc/43970336>,
        <https://de.wikisource.org/wiki/RE:Chimaira_2>;
    owl:sameAs <http://pleiades.stoa.org/places/638801>;
    geo:lat 36.4248213278;
    geo:long 29.1769395436;
    skos:altLabel "Avlan valley"@en,
        "Chimaera"@en,
        "Tal von Alwan"@de,
        "Χίμαιρα φάραγξ"@grc;
    skos:inScheme <https://pleiades.stoa.org/places>;
    prov:wasDerivedFrom [ rdfs:label "Barrington Atlas: BAtlas 65 B5 Chimaera" ];
