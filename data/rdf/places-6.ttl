    dcterms:bibliographicCitation "Arachne Tempel der Concordia Forum Romanum, Rom",
        "EDCS -17200190 = CIL 06, 00089",
        "Köb 2000 56-70",
        "LTUR I (1993), 316-320, s.v. \"Concordia, aedes\" (A. M. Ferroni)",
