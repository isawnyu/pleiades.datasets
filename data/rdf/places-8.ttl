<https://pleiades.stoa.org/places/888830080> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "Ard et al. 2023 ";
    dcterms:creator <https://pleiades.stoa.org/author/jbecker>;
    dcterms:description "The archaeological site at Le Peu (Charente) dates originally to the mid-fifth millennium BCE and preserves evidence of a fortified Middle Neolithic settlement with timber structures. The ditch and palisade fortifications and the timber structures represent the earliest evidence of such architecture in Atlantic Europe. The fortified site is located close to the monumental Tusson tumuli.";
    dcterms:modified "2023-02-27T06:19:39-04:00";
    dcterms:title "Le Peu (Charente)";
    cito:citesForInformation <https://www.cambridge.org/core/journals/antiquity/article/emergence-of-monumental-architecture-in-atlantic-europe-a-fortified-fifthmillennium-bc-enclosure-in-western-france/8ED741E657BCBE5522E7EC273F7D697D>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/47784683>;
    owl:sameAs <http://pleiades.stoa.org/places/888830080>;
    skos:altLabel "Le Peu (Charente)"@fr;
    skos:inScheme <https://pleiades.stoa.org/places>;
    prov:wasDerivedFrom [ rdfs:label "Pleiades" ];
    pleiades:hasFeatureType <https://pleiades.stoa.org/vocabularies/fortified-settlement>;
