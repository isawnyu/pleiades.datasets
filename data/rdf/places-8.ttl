<https://pleiades.stoa.org/places/844950> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "BAtlas 86 A3 Hypios fl.",
        "Keten 2020 Figure 1",
        "New Pauly Hypius [1] River in Asia Minor",
        "Pehlivan 2005 ",
        "RE Hypios",
        "Robert 1980 63-64",
        "TIB Paphlagonien 217-18",
        "TP (Talbert: CUP) 8A4 (Talbert 2093)",
        "TP (Talbert: CUP) 8A4 (Talbert 3447)",
        "Wikidata Hypius (Q65040488)",
        "Wikipedia (Turkish) Efteni Gölü Yaban Hayatı Geliştirme Sahası";
    dcterms:contributor <http://viaf.org/viaf/59162760>,
        <https://pleiades.stoa.org/author/jbecker>,
        <https://pleiades.stoa.org/author/sgillies>,
        <https://pleiades.stoa.org/author/thomase>;
    dcterms:coverage "river";
    dcterms:creator <http://viaf.org/viaf/39409558>;
    dcterms:description "A river mentioned in ancient sources. Modern scholars identify it with the lower/larger (Büyük) course of the modern Melen Çay (Buyukmelen), which drains the marshy Efteni Golü (much diminished from its pre-modern extent). Ancient people seem to have extended the \"Hypios\" name past the lake and up one of its tributaries, but scholarly opinion is divided as to whether this was the modern Ugursuyu/Ogursu/Akarsu (Robert 1980, whence Foss in BAtlas) or the upper/smaller (Küçük) Melen Çayı (Strobel in New Pauly).";
    dcterms:modified "2025-02-07T00:10:08-04:00";
