<https://pleiades.stoa.org/places/849390847> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "Pedersén 1998 147–150";
    dcterms:creator <https://pleiades.stoa.org/author/tseidler>;
    dcterms:description "Most documents found in the Northwest Palace, built by the Assyrian king Ashurnarsipal II (883–859 BC), predate the move of the new Assyrian capital to Dur-Šarrukin under Sargon II (721–705 BC). A few tablets were found in Rooms ZT 30 and ZT 31, on the eastern side of the northernmost courtyard of the palace. The administrative texts found in this archive repository include lists of quantities of oil (delivered to the palace), which were presumably stored in the large jars that were also found inside both rooms.";
    dcterms:modified "2022-10-10T09:27:31-04:00";
    dcterms:subject "ANE",
        "Assyrian";
    dcterms:title "Kalhu Archive 7";
    cito:citesForInformation <http://uu.diva-portal.org/smash/get/diva2:88568/FULLTEXT01.pdf>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/439136375>,
        <https://pleiades.stoa.org/places/894019>;
    owl:sameAs <http://pleiades.stoa.org/places/849390847>;
    skos:altLabel "Kalhu Archive 7"@en;
    skos:inScheme <https://pleiades.stoa.org/places>;
    prov:wasDerivedFrom [ rdfs:label "Pleiades" ];
    pleiades:hasFeatureType <https://pleiades.stoa.org/vocabularies/archive-repository>;
    pleiades:hasLocation <https://pleiades.stoa.org/places/plan-location-of-kalhu-archive-7>;
    pleiades:hasName <https://pleiades.stoa.org/places/kalhu-archive-7> .

<https://pleiades.stoa.org/places/85366721> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "Christiansen and Salvini 2016 A 8-39 (Q007040)",
        "Christiansen and Salvini 2016 A 9-16 (Q007061)",
        "Christiansen and Salvini 2016 CTU 4 CP Arg-01 (Q008271)",
        "Salvini 2008 p. 70; p. 412; p. 441",
        "Salvini 2012 p. 241f.";
    dcterms:contributor <https://pleiades.stoa.org/author/cjohansson>,
        <https://pleiades.stoa.org/author/jbecker>,
        <https://pleiades.stoa.org/author/rrattenborg>;
    dcterms:creator <https://pleiades.stoa.org/author/bchristiansen2>;
    dcterms:description "Davti-blur is the Armenian name of an Urartian settlement situated on a natural hill near the modern village Nor-Armavir. Just like the settlement on the immediately adjacent hill, Armavir, which in Urartian was called Argištihinili (\"city of Argišti\"), it was founded by Argišti I, son of Minua (8th century BCE). In Davti-Blur, a column base with an inscription of Argišti I was found, which reports the construction of a building. Furthermore, several inscriptions on clay pithoi by Argišti have been found there, which attest to the administrative activity at this place. A stone block of the Urartian king Sarduri II, son of Argišti I (8th century BCE), reveals that the place was further developed and extended by Sarduri II.";
    dcterms:modified "2025-10-30T12:13:14-04:00";
    dcterms:subject "ANE";
    dcterms:title "Davti-blur";
    cito:cites <http://www.worldcat.org/oclc/889416686>;
    cito:citesAsEvidence <http://oracc.museum.upenn.edu/ecut/Q007061>,
        <http://oracc.museum.upenn.edu/ecut/Q008271>;
    cito:citesForInformation <https://www.zotero.org/groups/pleiades/items/SHPA4R98>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/214160492>,
        <https://pleiades.stoa.org/places/825227>;
    owl:sameAs <http://pleiades.stoa.org/places/85366721>;
    skos:inScheme <https://pleiades.stoa.org/places>;
    prov:wasDerivedFrom [ rdfs:label "Pleiades" ];
    pleiades:hasFeatureType <https://pleiades.stoa.org/vocabularies/settlement>;
    pleiades:hasLocation <https://pleiades.stoa.org/places/cigs-location-of-davti-blur> .

