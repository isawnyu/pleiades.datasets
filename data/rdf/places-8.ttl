<https://pleiades.stoa.org/places/87882504> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "BTTo City Walls of Babylon C",
        "George 1992 137–141 (with fig. 7)",
        "Pedersén 2021 31 fig. 2.1";
    dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "The Neo-Babylonian kings Nabopolassar (r. 625–605 BC) and Nebuchadnezzar II (r. 604–562 BC) constructed an outer wall around the eastern side of Babylon. That mudbrick wall is reported to have had 120 towers and 5 entrances, including the Madānu Canal Gate. This access point to the city was probably located on the eastern stretch of the wall.";
    dcterms:modified "2021-01-29T15:11:42-04:00";
    dcterms:subject "ANE",
        "Babylonian";
    dcterms:title "Madānu Canal Gate";
    cito:citesAsEvidence <http://oracc.museum.upenn.edu/btto/Q007974>;
    cito:citesForInformation <http://www.worldcat.org/oclc/803804468>,
        <https://uppsala.app.box.com/s/cgm386mr39f0we39y8v49ktecc664k0k/file/722124240853>;
