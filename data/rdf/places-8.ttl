    dcterms:bibliographicCitation "New Pauly Brauron",
        "Papadimitriou 1963 ",
        "Perseus AAAB Brauron (Site)",
        "Wikidata Stoa at Brauron (Q132326811)",
        "Wikipedia (English) Brauron s.v. \"Π-shaped stoa\"";
    dcterms:contributor <https://pleiades.stoa.org/author/jbecker>,
        <https://pleiades.stoa.org/author/thomase>,
        <https://pleiades.stoa.org/author/tlandvatter>;
    dcterms:creator [ a <http://xmlns.com/foaf/0.1/Person>;
            foaf:name "Basil-Anne Stackpole" ],
        [ a <http://xmlns.com/foaf/0.1/Person>;
            foaf:name "Julie Mason" ];
    dcterms:description "The Stoa at Brauron, within the larger Artemis Brauronia complex, housed dining spaces as well as votive offerings to the goddess Artemis. The Stoa was Π-shaped, wrapping around a courtyard that separated it from the temple of Artemis at Brauron, which it faced. Worship at the cult site began ca. the eighth century BCE. The site was abandoned after a flood in the third century BCE.";
    dcterms:modified "2025-02-13T21:27:34-04:00";
