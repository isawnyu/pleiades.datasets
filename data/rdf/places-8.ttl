<https://pleiades.stoa.org/places/872106931%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Sanctuary of Pan at Paneas";
    spatial:C <https://pleiades.stoa.org/places/678324%23this>;
    rdfs:comment "The Paneion at Caesarea Philippi, a sanctuary site dedicated to Pan centered around a natural cave and spring site on the southwestern slopess of Mount Hermon. The sanctuary was first built in the Hellenistic period (before 200 BCE). A temple to Augustus was constructed in front of the cave during the reign of Herod the Great in 19 BCE, and the site was further expanded through 220 CE.";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/872106931> .

<https://pleiades.stoa.org/places/872106931/sanctuary-of-pan> dcterms:creator <https://pleiades.stoa.org/author/gmckee>;
    dcterms:description "Polygon representing the boundaries of the sanctuary site at Paneas, derived from an OpenStreetMap Way after Friedland 2012";
    dcterms:modified "2019-04-24T14:29:04-04:00";
    dcterms:title "OSM location of Sanctuary of Pan";
    owl:sameAs <http://pleiades.stoa.org/places/872106931/sanctuary-of-pan> .

<https://pleiades.stoa.org/places/872350435%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "San Nicola in Carcere";
    spatial:C <https://pleiades.stoa.org/places/207271756%23this>,
        <https://pleiades.stoa.org/places/423025%23this>,
        <https://pleiades.stoa.org/places/72845305%23this>;
    rdfs:comment "San Nicola in Carcere is a titular church in Rome's historical district (rione) Sant'Angelo, close to the Forum Boarium. The twelfth-century church is built atop the remains of Roman temples of the ancient Forum Holitorium and incorporates their remains into its structure.";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/872350435> .

