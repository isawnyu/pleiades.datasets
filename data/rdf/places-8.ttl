    dcterms:bibliographicCitation "Arachne Building 2104365: Tempel der Athena Ilia Çanakkale",
        "Denker 2023 ",
        "Goethert 1962 ",
        "Hertel 2004 ",
        "Holden 1964 ",
        "Pohl 2002 ",
        "Rose 2014 ",
        "TCW 1001334",
        "Troy Excavations: The Temple Of Athena ",
