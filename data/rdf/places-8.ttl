    cito:citesForInformation <http://www.english-heritage.org.uk/daysout/properties/silchester-roman-city-walls-and-amphitheatre/>,
        <http://www.pastscape.org.uk/hob.aspx?hob_id=241202%23>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/79368>;
