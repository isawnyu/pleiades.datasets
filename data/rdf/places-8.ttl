<https://pleiades.stoa.org/places/839719167%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Via Triumphalis";
    spatial:C <https://pleiades.stoa.org/places/423025%23this>,
        <https://pleiades.stoa.org/places/423034%23this>,
