<https://pleiades.stoa.org/places/237150019%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Egalgabarinutukua";
    spatial:C <https://pleiades.stoa.org/places/175106248%23this>,
        <https://pleiades.stoa.org/places/29492%23this>,
        <https://pleiades.stoa.org/places/305127727%23this>,
        <https://pleiades.stoa.org/places/305127728%23this>,
