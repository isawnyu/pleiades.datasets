    dcterms:bibliographicCitation "Excavations At Khorsabad ",
        "Khorsabad, The City of Sargon ",
        "Loud, Frankfort, and Jacobsen 1936 ",
        "Wikipedia (English) Dur-Sharrukin";
    dcterms:contributor <https://pleiades.stoa.org/author/thomase>;
    dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "The eighth-century-BC Assyrian king Sargon II (r. 721–705 BC) had several royal residences constructed in the citadel of his new capital, Dūr-Šarrukīn (modern Khorsabad). Residence J, which has constructed on the western side of the citadel, is presumed to have been for one of the highest officials of the Assyrian Empire. Since no inscriptions were discovered in the ruins of the building, the owner/principal occupant of the this Assyrian palace is not known.";
    dcterms:modified "2021-01-03T09:18:45-04:00";
    dcterms:subject "ANE",
        "Assyrian";
    dcterms:title "Khorsabad Residence J";
    cito:citesForInformation <https://archeologie.culture.fr/khorsabad/en/city>,
        <https://en.wikipedia.org/wiki/Dur-Sharrukin>,
        <https://oi.uchicago.edu/research/projects/excavations-khorsabad>,
        <https://www.zotero.org/groups/pleiades/items/KTVGQQFW>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/508774533>,
        <https://pleiades.stoa.org/places/748147228>,
        <https://pleiades.stoa.org/places/874458>;
