<https://pleiades.stoa.org/places/230761554> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "Kleiss 1976 F 4 No. 5 (p. 10)",
        "eCUT A 12-06 (Q007105)",
        "eCUT Išpuini, son of Sarduri I";
    dcterms:contributor <https://pleiades.stoa.org/author/jbecker>,
        <https://pleiades.stoa.org/author/tseidler>;
    dcterms:creator <https://pleiades.stoa.org/author/bchristiansen2>;
    dcterms:description "Kalecik (formerly known as Aralesk or Lesk) is a modern village situated ca. 5 km north of Van Kalesi in southeast Turkey. In the village church, a re-used cylindrical stone (presumably a column base) with a building inscription of the Urartian king Išpuini, son of Sarduri I (ninth century BCE), was found. Furthermore, a re-used stone slab with an inscription of the Urartian king Argišti, son of Minua and grandson of Išpuini (eighth century BCE) has also been found here.";
    dcterms:modified "2025-01-19T10:52:30-04:00";
    dcterms:subject "ANE",
        "Urartean",
        "Urartian",
        "Urartu";
    dcterms:title "Kalecik";
    cito:citesAsEvidence <http://oracc.org/ecut/Q007105/>;
    cito:citesForInformation <http://oracc.museum.upenn.edu/ecut/urartianrulersandtheirinscriptions/ipuinisonofsarduriia2andb2/>,
        <https://www.zotero.org/groups/pleiades/items/WZTF2D3Q>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/214160492>;
    owl:sameAs <http://pleiades.stoa.org/places/230761554>;
    skos:altLabel "Aralesk, Lesk, Kalajyk, Kalecik"@hy;
    skos:inScheme <https://pleiades.stoa.org/places>;
    prov:wasDerivedFrom [ rdfs:label "Pleiades" ];
