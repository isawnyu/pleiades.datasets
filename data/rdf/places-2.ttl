    dcterms:creator <https://pleiades.stoa.org/author/jbecker>;
    dcterms:description "An ancient, now-vanished, branch of the Nile River. Geophysical research has demonstrated that the Ahramat Branch, no longer visible to the naked eye, was located west of the main Nile River channel and flowed from south of Lisht to the area of the Giza Plateau area. This channel would have bordered on the complexes of more than 30 ancient pyramids ranging in date from the Old Kingdom to Second Intermediate Period (2686−1649 BCE).";
    dcterms:modified "2024-06-14T18:11:23-04:00";
    dcterms:title "Ahramat Branch";
    cito:citesForInformation <http://theconversation.com/we-mapped-a-lost-branch-of-the-nile-river-which-may-be-the-key-to-a-longstanding-mystery-of-the-pyramids-230092>,
        <https://www.nature.com/articles/s43247-024-01379-7>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/727172>;
    owl:sameAs <http://pleiades.stoa.org/places/234483664>;
    skos:altLabel "Ahramat Branch"@en;
    skos:inScheme <https://pleiades.stoa.org/places>;
    prov:wasDerivedFrom [ rdfs:label "Pleiades" ];
    pleiades:hasFeatureType <https://pleiades.stoa.org/vocabularies/river>;
    pleiades:hasName <https://pleiades.stoa.org/places/ahramat-branch> .

