<https://pleiades.stoa.org/places/298699921%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Regio X (Palatium)";
    spatial:C <https://pleiades.stoa.org/places/240853549%23this>,
        <https://pleiades.stoa.org/places/250568480%23this>,
        <https://pleiades.stoa.org/places/251058809%23this>,
        <https://pleiades.stoa.org/places/345477553%23this>,
        <https://pleiades.stoa.org/places/423025%23this>,
        <https://pleiades.stoa.org/places/564783056%23this>,
        <https://pleiades.stoa.org/places/565793497%23this>,
        <https://pleiades.stoa.org/places/705506085%23this>,
        <https://pleiades.stoa.org/places/792170100%23this>,
        <https://pleiades.stoa.org/places/989620426%23this>;
    rdfs:comment "Regio X (Palatium) is one of the Augustan regions of the city of Rome. The Regionary Catalogues indicate that this regio contained 20 shrines (aediculae), 89 townhouses (domūs), 48 warehouses (horrea), 44 bath houses, and 89 fountains. Its perimeter was recorded as 11,510 Roman feet (approx. 3.4 km).";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/298699921> .

