<https://pleiades.stoa.org/places/254273447> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "Carnabuci 2018 ",
        "Chini 1999 ",
        "Info.roma.it 2090: Privata Traiani",
        "Privata Traiani Domus ",
        "Wikidata Privata domus Traiani (Q135090191)",
        "vici.org 103630: Privata domus Traiani";
    dcterms:creator <https://pleiades.stoa.org/author/jbecker>;
    dcterms:description "The so-called \"Privata domus Traiani\" was an opulent townhouse on the Aventine Hill in Rome. Its foundations were eventually coopted in the third century CE for the construction of the Baths of Decius. Evidence from brickstamps dates the building to the Trajanic to early Antonine period, leading some scholars to suggest that Marcus Ulpius Traianus occupied this domus before his adoption by Nerva.";
    dcterms:modified "2026-08-03T14:40:54-04:00";
    dcterms:title "Privata domus Traiani";
    cito:citesAsRelated <https://vici.org/vici/103630>,
        <https://www.info.roma.it/monumenti_dettaglio.asp?ID_schede=2090>,
        <https://www.wikidata.org/wiki/Q135090191>;
    cito:citesForInformation <https://www.sovraintendenzaroma.it/i_luoghi/roma_antica/monumenti/privata_traiani_domus>,
        <https://www.zotero.org/groups/pleiades/items/Q9HXWA65>,
        <https://www.zotero.org/groups/pleiades/items/XT8G2ZQZ>;
