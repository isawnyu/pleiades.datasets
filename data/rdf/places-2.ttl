<https://pleiades.stoa.org/places/202833934%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Sumer";
    spatial:C <https://pleiades.stoa.org/places/326150788%23this>,
        <https://pleiades.stoa.org/places/44626252%23this>,
        <https://pleiades.stoa.org/places/912845%23this>,
