<https://pleiades.stoa.org/places/253721601%23this> a <http://geovocab.org/spatial#Feature>;
    rdfs:label "Temple O (Selinus)";
    spatial:C <https://pleiades.stoa.org/places/462489%23this>;
    rdfs:comment "Temple O at Selinus is a Doric-order temple dating to the early fifth century BCE. It is similar in design to Temple A. The temple measures 16.2 x 40.2 meters with a 6 x 14 columnar arrangement (6.23-meter order height).";
    foaf:isPrimaryTopicOf <https://pleiades.stoa.org/places/253721601> .

