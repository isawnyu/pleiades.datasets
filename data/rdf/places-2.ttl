    dcterms:bibliographicCitation "Bagg, RGTC 7/1 201";
    dcterms:creator <https://pleiades.stoa.org/author/jnovotny>;
    dcterms:description "Qumasi is a Quean fortress located on the Cilician plain. In the eighth century BC, perhaps only for a short time, Phrygia controlled the territory in which Qumasi was located. The Assyrian king Sargon II (r. 721-705), after his armies defeated the Phrygian king Midas (= Mitâ of Musku), restored Qumasi to Que, which was then a province of the Assyrian Empire.";
    dcterms:modified "2020-09-02T10:02:11-04:00";
    dcterms:subject "ANE",
        "Assyrian";
    dcterms:title "Qumasi";
    cito:citesForInformation <http://www.worldcat.org/oclc/230137758>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/605795336>,
        <https://pleiades.stoa.org/places/648670>,
        <https://pleiades.stoa.org/places/648792>,
        <https://pleiades.stoa.org/places/652445664>,
        <https://pleiades.stoa.org/places/907036116>,
        <https://pleiades.stoa.org/places/930131678>,
        <https://pleiades.stoa.org/places/944349915>;
    owl:sameAs <http://pleiades.stoa.org/places/257997170>;
    skos:altLabel "Qumasi"@akk;
    skos:inScheme <https://pleiades.stoa.org/places>;
    prov:wasDerivedFrom [ rdfs:label "Pleiades" ];
    pleiades:hasFeatureType <https://pleiades.stoa.org/vocabularies/fort>,
        <https://pleiades.stoa.org/vocabularies/unlocated>;
    pleiades:hasName <https://pleiades.stoa.org/places/qumasi> .

