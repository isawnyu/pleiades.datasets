    dcterms:bibliographicCitation "BAtlas 25 D2 3",
        "CAG 40 page 154",
        "Coupry 1965 pages 436-441 (with plan and photographs)",
        "Mérimée Villa gallo-romaine de Barat de Vin",
        "PECS (Perseus) see under \"SORDE L'ABBAYE Landes, France\"";
    dcterms:contributor <http://viaf.org/viaf/59162760>,
