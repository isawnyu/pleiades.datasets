        "TM GEO ID 42537: Locidae Regi",
        "TP (Talbert: CUP) 7A3 (Talbert 3079)";
    dcterms:contributor [ a <http://xmlns.com/foaf/0.1/Person>;
            foaf:name "Richard Talbert" ],
        <http://viaf.org/viaf/59162760>,
        <https://pleiades.stoa.org/author/jbecker>,
