<https://pleiades.stoa.org/places/283551279> a <http://www.w3.org/2004/02/skos/core#Concept>,
        <https://pleiades.stoa.org/places/vocab#Place>;
    dcterms:bibliographicCitation "Olshausen 1984 page 59";
    dcterms:contributor <https://pleiades.stoa.org/author/jbecker>;
    dcterms:creator <https://pleiades.stoa.org/author/thomase>;
    dcterms:description "Olshausen describes at Horoztepe (Berg) the remains of a fortified settlement (Burg-ruinen) with Hellenistic stairways, cisterns, and rock tombs, but walls of a \"later date\". Horoztepe, located at modern Bergaa in Turkey's Tokat province, is best known as the site of a Bronze Age settlement and associated cemetery of the Hatti culture. Only cursory publications of the mid-20th-century excavations have appeared; none mention a later fortification, and none are visible in modern, publicly available aerial/satellite imagery.";
    dcterms:modified "2025-04-24T12:30:18-04:00";
    dcterms:title "Horoztepe Hellenistic Fortification";
    cito:citesForInformation <https://www.zotero.org/groups/pleiades/items/MX52KPKZ>;
    rdfs:seeAlso <https://pleiades.stoa.org/places/852535992>,
        <https://pleiades.stoa.org/places/857345>;
    owl:sameAs <http://pleiades.stoa.org/places/283551279>;
    skos:inScheme <https://pleiades.stoa.org/places>;
    prov:wasDerivedFrom [ rdfs:label "Pleiades" ];
    pleiades:hasFeatureType <https://pleiades.stoa.org/vocabularies/fortified-settlement> .

